# Allow only the runtime source and container health probe into the build context.
**
!Dockerfile
!requirements.txt
!app/
!app/**
!migrations/
!migrations/**
!scripts/
!scripts/container_health.py

# Local state and credentials stay excluded even beneath allowed directories.
**/__pycache__
**/*.py[cod]
**/.env
**/.env.*
**/*.db
**/*.sqlite*
**/*.pem
**/*.key
