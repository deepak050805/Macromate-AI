APP_ENV=development
SECRET_KEY=replace-with-a-random-key-at-least-32-characters-long
DATABASE_URL=postgresql://macromate:replace-local-password@localhost:5432/macromate
# Optional PostgreSQL per-host connection timeout override (seconds; default 5).
# PGCONNECT_TIMEOUT=5
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=replace-with-mail-account
MAIL_PASSWORD=replace-with-provider-app-password
MAIL_DEFAULT_SENDER=replace-with-sender-address
OTP_EXPIRY_SECONDS=300
OTP_COOLDOWN_SECONDS=60
RATELIMIT_STORAGE_URI=memory://
LOG_LEVEL=INFO
# Required in production; comma-separated names without schemes or paths.
TRUSTED_HOSTS=localhost,127.0.0.1
# Compose only: replace each placeholder before starting.
POSTGRES_USER=macromate
POSTGRES_PASSWORD=replace-with-a-strong-local-database-password
POSTGRES_DB=macromate
REDIS_PASSWORD=replace-with-a-strong-local-redis-password
